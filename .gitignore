# Root .gitignore
data/
*.parquet
*.pyc
__pycache__/

# Secrets: never commit keys or local environment files
.env
.env.*
.venv/
.bootstrap/
__pycache__/
.pytest_cache/
.superpowers/
crypto-paper-agent/artifacts/
crypto-paper-agent/market-data/
/*.log
/tmp/

# Graphify machine state; share only portable graph/report/evidence outputs.
/graphify-out/.*
/graphify-out/cache/
